{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "core": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/core",
      "sourceRoot": "projects/core/src",
      "prefix": "core",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "styles": [
              "node_modules/normalize.css/normalize.css",
              "projects/core/src/custom-theme.scss"
            ]
          },
          "configurations": {
            "production": {
              "target": "core:esbuild:production"
            },
            "development": {
              "target": "core:esbuild:development",
              "dev": true,
              "fileReplacements": [
                {
                  "replace": "projects/core/src/environments/environment.ts",
                  "with": "projects/core/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "core:serve-original:development",
            "rebuildDelay": 0,
            "hmr": false,
            "fileReplacements": [
              {
                "replace": "projects/core/src/environments/environment.ts",
                "with": "projects/core/src/environments/environment.development.ts"
              }
            ],
            "dev": true,
            "port": 0
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/core/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/core/public"
              }
            ],
            "styles": ["node_modules/normalize.css/normalize.css", "projects/core/src/styles.scss"]
          }
        },
        "esbuild": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "browser": "projects/core/src/main.ts",
            "polyfills": ["zone.js", "es-module-shims"],
            "tsConfig": "projects/core/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/core/public"
              }
            ],
            "styles": ["node_modules/normalize.css/normalize.css", "projects/core/src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "projects/core/ngsw-config.json",
              "fileReplacements": [
                {
                  "replace": "tsconfig.json",
                  "with": "tsconfig.prod.json"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/core/src/environments/environment.ts",
                  "with": "projects/core/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "development"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "core:esbuild:production"
            },
            "development": {
              "buildTarget": "core:esbuild:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4200
          }
        }
      }
    },
    "hmdm-ui-kit": {
      "projectType": "library",
      "root": "projects/hmdm-ui-kit",
      "sourceRoot": "projects/hmdm-ui-kit/src",
      "prefix": "hmdm",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/hmdm-ui-kit/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/hmdm-ui-kit/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/hmdm-ui-kit/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
