<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <artifactId>ui-library</artifactId>

    <packaging>pom</packaging>
    <version>0.1.0</version>
    <name>UI Library for MDM</name>

    <parent>
        <groupId>com.hmdm</groupId>
        <artifactId>root</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <build>
        <plugins>
            <!-- Check whether front-end files are changes and the front-end should be rebuilt -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>1.8</version>

                <executions>
                    <execution>
                        <id>check-web-build</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <exportAntProperties>true</exportAntProperties>
                            <target>
                                <uptodate
                                        property="web.build.uptodate"
                                        targetfile="${project.basedir}/../server/src/main/web/dist/hmdm-ui-kit">
                                    <srcfiles dir="${project.basedir}/../server/src/main/web/projects/hmdm-ui-kit">
                                        <include name="**/*"/>
                                    </srcfiles>
                                </uptodate>
                                <condition property="skip.web.build" value="true" else="false">
                                    <isset property="web.build.uptodate"/>
                                </condition>
                                <echo message="skip.web.build=${skip.web.build}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Build Angular UI Library -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.1</version>

                <configuration>
                    <skip>${skip.web.build}</skip>
                    <workingDirectory>${project.basedir}/../server/src/main/web</workingDirectory>
                    <installDirectory>${project.basedir}/../server/src/main/web</installDirectory>
                </configuration>

                <executions>
                    <!-- Install Node.js and npm -->
                    <execution>
                        <id>install-node-and-npm</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>   
                        </goals>
                        <configuration>
                            <nodeVersion>v22.17.0</nodeVersion>
                        </configuration>
                    </execution>

                    <!-- Install pnpm -->
                    <execution>
                        <id>install-pnpm</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>install -g pnpm@10.26.0</arguments>
                                <environmentVariables>
                                    <CI>true</CI>
                                </environmentVariables>
                        </configuration>
                    </execution>

                    <!-- Install dependencies -->
                    <execution>
                        <id>pnpm-install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>exec --package=pnpm@10.26.0 -- pnpm install --frozen-lockfile --prefer-offline</arguments>
                            <environmentVariables>
                                <CI>true</CI>
                            </environmentVariables>
                        </configuration>
                    </execution>

                    <!-- Build UI library -->
                    <execution>
                        <id>build-ui-library</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>exec --package=pnpm@10.26.0 -- pnpm exec ng build hmdm-ui-kit --configuration production</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
