# Address the Headwind server advertises to devices.
#
# Use your PC's LAN IP (ipconfig -> IPv4 Address of your Wi-Fi/Ethernet adapter).
# That address works from the Windows browser, from the Android emulator, and
# from real devices on the same network.
#
# 10.0.2.2 also works, but ONLY from an emulator - panel file links break.

HMDM_HOST=192.168.1.100
