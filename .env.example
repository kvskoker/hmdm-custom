# ===========================================================================
# Copy to .env and edit. Two settings decide everything else.
# ===========================================================================

# dev  - http on localhost, panel on :8080, Postgres exposed for inspection
# prod - https on your domain via Caddy and Let's Encrypt, nothing else exposed
DEPLOY_MODE=dev

# In dev: the address your PHONE or EMULATOR can reach this machine on.
#         10.0.2.2 is the Android emulator's route to the host.
#         Use your LAN IP (e.g. 192.168.1.50) for a real handset.
# In prod: the public domain. Its DNS A record must already point here.
HMDM_DOMAIN=10.0.2.2

# Required in prod: Let's Encrypt sends expiry warnings here.
LETSENCRYPT_EMAIL=

# Host ports. Container ports stay unchanged. Choose unused ports explicitly;
# deployment does not automatically move devices to another port.
# In prod the panel and database bind to 127.0.0.1; in dev to all interfaces.
HMDM_HTTP_PORT=8080
DB_HOST_PORT=5433
# Changing MQTT requires matching launcher settings; see README.
MQTT_HOST_PORT=31000
# Change these only with public 80/443 forwarding to the chosen host ports.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Database. Change SQL_PASS before the first start in production - it is
# written into the database on creation and is awkward to change afterwards.
# ---------------------------------------------------------------------------
SQL_BASE=hmdm
SQL_USER=hmdm
SQL_PASS=topsecret

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Panel language: en or ru
LANGUAGE=en
ADMIN_EMAIL=admin@localhost

# MQTT push authentication. 1 in production, 0 makes local testing simpler.
MQTT_AUTH=1

# Email, for password recovery. Leave blank to disable.
SMTP_HOST=
SMTP_PORT=25
SMTP_SSL=0
SMTP_STARTTLS=0
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Set to the Let's Encrypt STAGING endpoint while you are testing DNS, so a
# misconfigured domain does not burn the real rate limit. Unset for real certs.
# CADDY_CA=https://acme-staging-v02.api.letsencrypt.org/directory
