# Host-installed Nginx only. Replace the domain and port before enabling.
# Initial HTTP configuration; enable trusted HTTPS before enrolling devices.
# If this hostname already has a server block, merge into that block instead.
server {
    listen 80;
    server_name mdm.maxcit.com;
    client_max_body_size 512m;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
